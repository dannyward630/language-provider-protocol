{
  "name": "required-object-params",
  "description": "Every request requires an object-valued params field; missing or non-object params receive -32602.",
  "scope": "protocol",
  "steps": [
    {"request":{"id":1,"method":"lpp/initialize","params":{"protocolVersion":"1.0","clientInfo":{"name":"wright","version":"0.2.0"}}},"expectResponse":{"result":{"protocolVersion":"1.0","serverInfo":{"name":{"$provider":"nonEmptyString"},"version":{"$provider":"nonEmptyString"}},"languages":{"$provider":"languageList"},"capabilities":{"check":{"$provider":"boolean"},"compile":{"$provider":"boolean"},"reconstruct":{"$provider":"boolean"},"symbols":{"$provider":"boolean"},"definition":{"$provider":"boolean"},"references":{"$provider":"boolean"},"rename":{"$provider":"boolean"},"editValidation":{"$provider":"boolean"}}}}},
    {"request":{"id":2,"method":"lpp/shutdown"},"expectResponse":{"error":{"code":-32602,"message":{"$provider":"nonEmptyString"}}}},
    {"request":{"id":3,"method":"lpp/shutdown","params":[]},"expectResponse":{"error":{"code":-32602,"message":{"$provider":"nonEmptyString"}}}},
    {"request":{"id":4,"method":"lpp/shutdown","params":null},"expectResponse":{"error":{"code":-32602,"message":{"$provider":"nonEmptyString"}}}},
    {"request":{"id":5,"method":"lpp/shutdown","params":{}},"expectResponse":{"result":null}}
  ]
}
